# KernelSU build profile for Redmi Note 10 Pro 5G (chopin, MT6893, kernel 4.14.186)
# Source: MiCode/Xiaomi_Kernel_OpenSource  branch: chopin-r-oss
CONFIG_ENV=config/chopin.env

KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=chopin-r-oss
KERNEL_CONFIG=chopin_user_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
KERNEL_NAME=chopin

# Old 4.14 tree: use the safe clang pinned for 4.x
CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r416183c
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# SukiSU-Ultra builtin branch ships SUSFS itself -> avoids the broken non-GKI
# susfs4ksu KernelSU-side patch on 4.x trees. Manual hooks for old kernels.
KSU_VARIANT=kernelsu
KSU_REF=v0.9.5
KSU_HOOK_MODE=auto
ENABLE_KPM=false

ENABLE_SUSFS=true
SUSFS_BRANCH=auto

# 4.14 predates path_umount() (added 5.9) -- required for SU mount hiding.
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false

ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=CONFIG_CC_STACKPROTECTOR_STRONG=n CONFIG_CC_STACKPROTECTOR=n CONFIG_CC_STACKPROTECTOR_NONE=y

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
